# Base URL of the API. Leave empty when the web app and API share a domain (Vite dev server proxies /api).
VITE_API_URL=

# Per-file upload limit shown and checked in the browser. Keep in sync with the API's MAX_UPLOAD_MB.
VITE_MAX_UPLOAD_MB=40

# Development only: where the Vite dev server proxies /api and /socket.io
VITE_DEV_API_TARGET=http://localhost:4000
